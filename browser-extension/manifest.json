{
  "manifest_version": 3,
  "name": "mnemochron Browser Bridge",
  "version": "0.1.0",
  "description": "Tracks tabs and reading progress for mnemochron.",
  "permissions": ["tabs", "activeTab", "storage", "scripting", "alarms"],
  "host_permissions": ["http://localhost:9001/*"],
  "action": {
    "default_title": "mnemochron",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
