{
  "name": "nexus-openclaw",
  "version": "0.1.0",
  "description": "NEXUS — Neural EXperience & Understanding Synthesizer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "health-check": "node dist/scripts/health-check.js",
    "openclaw:version": "openclaw --version",
    "openclaw:setup": "openclaw setup",
    "openclaw:gateway": "openclaw gateway run",
    "openclaw:health": "openclaw health --json",
    "browser:bridge": "node browser-extension/api-server.js",
    "demo:dashboard": "node dist/scripts/demo-dashboard.js",
    "demo:browser": "python scripts/demo_browser_activity.py --import-tabs",
    "setup": "node dist/scripts/setup.js",
    "thread:create": "node dist/scripts/thread-create.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@notionhq/client": "^2.2.14",
    "@slack/web-api": "^6.12.0",
    "axios": "^1.6.0",
    "chokidar": "^3.6.0",
    "clipboardy": "^4.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.3.5",
    "js-yaml": "^4.1.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^6.9.13",
    "openai": "^4.47.0",
    "openclaw": "^2026.5.6",
    "p-limit": "^6.1.0",
    "winston": "^3.13.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^6.4.14",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
